api:
  dashboard: true
  insecure: false

metrics:
  prometheus:
    addRoutersLabels: true

entryPoints:
  web:
    address: ':80'
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ':443'

certificatesResolvers:
  letsencrypt:
    acme:
      email: "your@email.com"
      storage: "/letsencrypt/acme.json"
      httpChallenge:
        entryPoint: web

providers:
  # Docker Provider für Container-Discovery (inkl. eigenes Dashboard)
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false

  # HTTP Provider für Backend-Traefiks
  # Wird automatisch während der Installation konfiguriert
  # Entkommentieren und Endpoints hinzufügen falls benötigt:
  # http:
  #   endpoints:
  #     - "http://172.16.16.140/api"
  #     - "http://172.16.16.141/api"
  #   pollInterval: "10s"

ping:
  entryPoint: "web"

global:
  checknewversion: true
  sendanonymoususage: false

log:
  level: INFO
  filePath: "/var/log/traefik/traefik.log"
  format: json

accessLog:
  filePath: "/var/log/traefik/access.log"
  format: json
  bufferingSize: 50
  fields:
    defaultMode: keep
