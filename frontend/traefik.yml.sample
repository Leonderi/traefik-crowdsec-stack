services:
  traefik:
    image: traefik:${TRAEFIK_VERSION:-3.6}
    container_name: traefik-frontend
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    ports:
      - "80:80"
      - "443:443"
    env_file:
      - ../data/traefik-frontend/.env
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ../data/traefik-frontend/config/traefik.yml:/etc/traefik/traefik.yml:ro
      - ../data/traefik-frontend/config:/etc/traefik/config:ro
      - ../data/traefik-frontend/letsencrypt:/letsencrypt
      - ../data/traefik-frontend/logs:/var/log/traefik
    labels:
      # Dashboard des vorgeschalteten Traefik
      traefik.enable: "true"
      traefik.http.routers.dashboard.rule: "Host(`${TRAEFIK_DASHBOARD_HOST:-traefik.yourdomain.com}`)"
      traefik.http.routers.dashboard.entrypoints: "websecure"
      traefik.http.routers.dashboard.service: "api@internal"
      traefik.http.routers.dashboard.tls.certresolver: "letsencrypt"
      traefik.http.routers.dashboard.middlewares: "dashboard-auth"

      # Basic Auth für Dashboard (wird während Installation konfiguriert)
      traefik.http.middlewares.dashboard-auth.basicauth.users: "admin:$$apr1$$placeholder"
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 10s
      timeout: 1s
      retries: 3
      start_period: 10s
