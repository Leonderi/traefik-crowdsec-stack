api:
  dashboard: true
  insecure: false

metrics:
  prometheus:
    addRoutersLabels: true

entryPoints:
  web:
    address: ':80'
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ':443'

certificatesResolvers:
  letsencrypt:
    acme:
      email: "your@email.com"
      storage: "/letsencrypt/acme.json"
      tlsChallenge: {}

providers:
  # HTTP Provider für Backend-Traefiks
  # Endpoints werden während der Installation konfiguriert
  http:
    endpoints: []
    pollInterval: "10s"

  # File Provider für zusätzliche dynamische Konfiguration
  file:
    directory: "/etc/traefik/config"
    watch: true

ping:
  entryPoint: "web"

global:
  checknewversion: true
  sendanonymoususage: false

log:
  level: INFO
  filePath: "/var/log/traefik/traefik.log"
  format: json

accessLog:
  filePath: "/var/log/traefik/access.log"
  format: json
  bufferingSize: 50
  fields:
    defaultMode: keep
